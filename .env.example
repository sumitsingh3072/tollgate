# Copy to .env. Only GEMINI_API_KEY is needed for the default setup; everything else is optional.
# Defaults: models via the Gemini API, bundled Postgres, generated admin token, no sign-in (localhost).

# --- Models -----------------------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_FAST_MODEL=gemma-4-26b-a4b-it
# GEMINI_SMART_MODEL=gemma-4-31b-it
# Gemma inlines <thought>...</thought> unless thinking is minimal: minimal | high | (empty)
# GEMINI_THINKING_LEVEL=minimal

# Fully local instead (needs ~8 GB free RAM; first start downloads ~4 GB):
#   set UPSTREAM_PROVIDER=ollama, then run: docker compose --profile ollama up -d
# UPSTREAM_PROVIDER=gemini
# OLLAMA_FAST_MODEL=gemma3:1b
# OLLAMA_SMART_MODEL=gemma3:4b        # e.g. gemma4:e4b for Gemma 4 (larger download)
# Ollama running natively on the host instead of in Docker (faster on Apple Silicon):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- Data -------------------------------------------------------------------------------------
# Default: the bundled Postgres container. For Neon, paste its connection string as-is.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Security ---------------------------------------------------------------------------------
# Default: generated on first start and shared by gateway + dashboard. Set one to pin it
# (e.g. to call /admin yourself): openssl rand -hex 32
# ADMIN_TOKEN=

# --- Accounts (for a public / remote deployment) ----------------------------------------------
# Without these the dashboard has NO sign-in, so keep BIND_ADDRESS at its localhost default.
# Keys from https://dashboard.clerk.com -> API keys. The publishable key is baked in at build time.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Caps for self-serve users, who share the gateway's model capacity.
# USER_MAX_KEYS=5
# USER_MAX_RPM=120
# USER_MAX_DAILY_TOKENS=500000

# --- Network ----------------------------------------------------------------------------------
# 127.0.0.1 (default) = this machine only. 0.0.0.0 = reachable remotely (enable Clerk, add TLS).
# BIND_ADDRESS=127.0.0.1
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# Public URLs when deployed remotely (the gateway URL is baked into the dashboard at build time):
# NEXT_PUBLIC_GATEWAY_URL=https://gateway.example.com
# CORS_ORIGINS=https://dashboard.example.com

# --- Tuning -----------------------------------------------------------------------------------
# KEY_CACHE_TTL=60
# LOG_FLUSH_INTERVAL=2
# UPSTREAM_TIMEOUT=120                # raise for big local models on CPU
# FALLBACK_TIMEOUT=30                 # max wait before a chain falls back (incl. queue wait; streams: first byte); 0 = off
# Response cache (separate LFU Redis): per-route TTL, max entry size, second-sight window, memory cap
# CACHE_TTL=86400
# CACHE_MAX_ENTRY_BYTES=16384
# CACHE_SEEN_TTL=3600
# CACHE_MAX_MEMORY=256mb

# --- Sharing the model fairly ----------------------------------------------------------------
# Requests in flight per upstream model; the rest wait in Tollgate's fair (VTC) queue.
# UPSTREAM_MAX_PARALLEL=4
# FAIR_QUEUE_MODE=fair                # fair | fifo | off (fifo/off exist for benchmarks)
# FAIR_MAX_QUEUE_PER_KEY=20
# FAIR_MAX_WAIT_S=30
# Identical in-flight requests share one upstream call:
# COALESCING_ENABLED=true

# --- Logging ----------------------------------------------------------------------------------
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# LOG_FORMAT=json                     # console | json
