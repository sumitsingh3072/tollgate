# Copy to .env (repo root). Read by docker compose and by the backend when run locally.

# --- Upstream: Gemma models via the Gemini API (OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_FAST_MODEL=gemma-4-26b-a4b-it
# GEMINI_SMART_MODEL=gemma-4-31b-it

# --- Data ---
# Neon: paste the connection string as-is (sslmode/channel_binding are normalized for asyncpg).
# Local Postgres instead: `docker compose --profile localdb up -d` and use
#   postgresql://tollgate:tollgate@localhost:5432/tollgate   (host runs)
#   postgresql://tollgate:tollgate@postgres:5432/tollgate    (backend in docker)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0
MOCK_UPSTREAM_URL=http://localhost:9000/v1

# --- Security ---
# Shared by the gateway (/admin auth) and the dashboard's server-side proxy. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000

# --- Tuning ---
KEY_CACHE_TTL=60
LOG_FLUSH_INTERVAL=2
UPSTREAM_TIMEOUT=60

# --- Logging ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# console (human) or json (one object per line, for log shippers)
LOG_FORMAT=console
